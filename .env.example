# LiveKit Cloud project credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# LiveKit Inference is billed through LiveKit Cloud. No provider keys are
# required for the Phase 1 STT, LLM, or TTS models.

# Supabase server-side credentials. Keep the service-role key private.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

